        { "name": "Leg Press", "sets": 2, "repsMin": 10, "repsMax": 12, "rpe": "6-7" },
        { "name": "Leg Curl", "sets": 2, "repsMin": 12, "repsMax": 15, "rpe": "6-7" },
        { "name": "Calf Raise", "sets": 3, "repsMin": 12, "repsMax": 15, "rpe": "6-7" }
